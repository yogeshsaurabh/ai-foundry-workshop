# ── Azure AI Foundry Project ─────────────────────────────────────────────────────────────────
# Find all values in: Foundry portal → your project → Overview
PROJECT_ENDPOINT=https://<AI-FOUNDRY-NAME>.services.ai.azure.com/api/projects/<AI-PROJECT-NAME>
AZURE_OPENAI_ENDPOINT=https://<AI-FOUNDRY-NAME>.services.ai.azure.com/openai/v1
AZURE_OPENAI_KEY=<AI-FOUNDRY-API-KEY>

# ── Authentication ───────────────────────────────────────────────────────────────────────────
# Used by: 1-authentication.ipynb
TENANT_ID=<AZURE-TENANT-ID>

# ── Model Deployments ────────────────────────────────────────────────────────────────────────
# Used by: all agent/chat/framework notebooks
MODEL_DEPLOYMENT_NAME=gpt-5.4
# Used by: 2-embeddings.ipynb
EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-large
# Used by: 4-phi-4.ipynb
MICROSOFT_MODEL=Phi-4
# Used by: 5-deep-seek-v3.ipynb
MODEL_NAME=DeepSeek-V3.2

# ── Connections ──────────────────────────────────────────────────────────────────────────────
# Used by: 4-bing_grounding.ipynb
GROUNDING_WITH_BING_CONNECTION_NAME=BingSearch

# ── Observability / Tracing ──────────────────────────────────────────────────────────────────
# Used by: 1-Observability.ipynb
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true
AZURE_SDK_TRACING_IMPLEMENTATION=opentelemetry

# ── Frontend  (3-ai-native-e2e-sample only — not used by notebooks) ──────────────────────────
VITE_API_URL=https://localhost:8003
VITE_DEFAULT_THEME=dark
VITE_API_VERSION=v1
